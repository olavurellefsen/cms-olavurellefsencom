{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-usable/types/**/*.ts",
    ".next-usable/dev/types/**/*.ts",
    ".next-umbraco/types/**/*.ts",
    ".next-umbraco/dev/types/**/*.ts",
    ".next-fallback/types/**/*.ts",
    ".next-fallback/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "umbraco/**/bin", "umbraco/**/obj"]
}
