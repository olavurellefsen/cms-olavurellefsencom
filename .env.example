NEXT_PUBLIC_SITE_URL=https://www.olavurellefsen.com
NEXT_PUBLIC_USABLE_CMS_ORIGIN=https://cms.usable.dev
NEXT_PUBLIC_USABLE_CMS_SITE_ID=
NEXT_PUBLIC_USABLE_CMS_INTEGRATION_KEY=
USABLE_API_BASE_URL=https://usable.dev
USABLE_CMS_WORKSPACE_ID=
USABLE_CMS_GLOBAL_CONFIG_FRAGMENT_ID=
USABLE_CMS_SERVER_TOKEN=
# Must be read-write for runtime page discovery/creation; never expose it to browser code.
USABLE_WEB_ANALYTICS_API_KEY=
# Site-scoped read key for the private CMS analytics panel; never expose it to browser code.
USABLE_WEB_ANALYTICS_ORIGIN=https://web-analytics.usable.dev
CMS_CONTENT_SOURCE=usable
# Optional Umbraco sidecar. Keep the sync key server-only.
UMBRACO_ORIGIN=http://localhost:5000
UMBRACO_BACKOFFICE_ORIGIN=http://localhost:5000
UMBRACO_SYNC_API_KEY=
# Optional exact parent origin accepted by the localhost:3000 Umbraco broker bridge.
NEXT_PUBLIC_UMBRACO_BACKOFFICE_ORIGIN=http://127.0.0.1:5099
# Umbraco uses USABLE_CMS_SERVER_TOKEN only to verify the published canonical readback.
# Draft and publish actions use the signed-in human editor's Usable broker session.
